# Copy to .env and fill in. Never commit .env.
# Neon: Console -> SIQshift -> Connection Details (use the unpooled/direct string).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Neon Auth base URL: Console -> SIQshift -> Auth -> base_url.
# The API derives the JWKS URL and expected token issuer from this.
AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth

PORT=3000
NODE_ENV=development

# Comma-separated allowlist. HTTPS required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5180
# Production: CORS_ORIGINS=https://siqshift.siqstack.com

# Integration/smoke tests only. Point at a disposable Neon branch, never production.
TEST_DATABASE_URL=

# Desktop only, and read at COMPILE time (option_env!), not at runtime. Set these
# in the shell before `pnpm --filter @siqshift/desktop tauri build` or the binary
# ships pointing at localhost.
#   SIQSHIFT_AUTH_URL  same value as AUTH_BASE_URL above
#   SIQSHIFT_API_URL   where the API is reachable, e.g. https://api.siqshift.siqstack.com

# Web dashboard (apps/web). Vite only exposes VITE_-prefixed vars to the browser.
VITE_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_API_BASE_URL=http://localhost:3977
# Production: VITE_API_BASE_URL=https://api.siqshift.siqstack.com
