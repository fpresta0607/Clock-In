# Copy to .env and fill in. Never commit .env.
# Neon: Console -> Clock-In -> Connection Details (use the unpooled/direct string).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Neon Auth base URL: Console -> Clock-In -> Auth -> base_url.
# The API derives the JWKS URL and expected token issuer from this.
AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth

PORT=3000
NODE_ENV=development

# Comma-separated allowlist. HTTPS required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:1420

# Integration/smoke tests only. Point at a disposable Neon branch, never production.
TEST_DATABASE_URL=
