{
  "name": "clock-in",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=1 --if-present build",
    "test": "pnpm --recursive --workspace-concurrency=1 test && pnpm test:release-workflow",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 typecheck",
    "test:release-workflow": "node --test scripts/release-tauri-config.test.mjs scripts/updater-manifest.test.mjs scripts/release-signing-state.test.mjs"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "js-yaml": "^5.2.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
